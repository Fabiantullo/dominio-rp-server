# ============================================
# .env.example - Plantilla de Variables
# ============================================
# Copiar este archivo a .env y completar con valores reales
# El archivo .env está ignorado en .gitignore por seguridad

# ==================
# FIVEM SERVER CONFIG
# ==================
FIVEM_LICENSE_KEY=your_fivem_license_key_here
FIVEM_HOST_NAME=Dominio RP | Servidor
FIVEM_SERVER_DESCRIPTION=Servidor FiveM con QBCore
FIVEM_MAX_PLAYERS=32
FIVEM_PORT=30120

# ==================
# BASE DE DATOS
# ==================
# Configuración de conexión MySQL para oxmysql
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_database_password
MYSQL_DATABASE=QBCore_BASE
MYSQL_PORT=3306
MYSQL_CHARSET=utf8mb4

# ==================
# STEAM WEB API
# ==================
# Obtener en https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# ==================
# DISCORD (Opcional)
# ==================
# Para webhooks y notificaciones a Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_SERVER_ID=your_discord_server_id

# ==================
# LOCALE Y CONFIGURACIÓN
# ==================
# Idioma y localización
LOCALE=es-AR
QB_LOCALE=es

# Sistema de target
USE_TARGET=true

# Configuración de voz
USE_NATIVE_AUDIO=true
VOICE_USE_SENDING_RANGE_ONLY=false
VOICE_DEFAULT_CYCLE=GRAVE
VOICE_DEFAULT_VOLUME=0.3
VOICE_ENABLE_RADIO_ANIM=1
VOICE_SYNC_DATA=1
